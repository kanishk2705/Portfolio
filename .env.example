# ----------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.
# ----------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000

# Database
DATABASE_PATH=./database/portfolio.db

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CSRF_SECRET=replace-with-a-different-long-random-string

# Admin account (used once by database/seed.js to create your login)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-before-seeding

# Optional: GitHub personal access token (no scopes needed) for the admin
# "Import from GitHub" button. Without it GitHub allows 60 requests/hour.
GITHUB_TOKEN=

# Uploads
# Where uploaded media is stored. On Render, point this at the persistent
# disk (e.g. /var/data/uploads) so uploads survive redeploys.
UPLOADS_PATH=./uploads
MAX_IMAGE_SIZE_MB=8
MAX_VIDEO_SIZE_MB=200
MAX_DOCUMENT_SIZE_MB=20
